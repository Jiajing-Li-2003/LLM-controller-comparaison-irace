#!/bin/bash
###############################################################################
# This script is to tune the Finite State Machine inside the AutoMoDe software.
#
# PARAMETERS:
# $1 is the ID of the candidate to be evaluated
# $2 is the instance ID
# $3 is the seed
# $4 is the instance name
# The rest ($* after `shift 4') are parameters for running AutoMoDe (i.e. the
#					  finite state machine configuration).
#
# RETURN VALUE:
# This script should print a single numerical value (the value to be minimized).
###############################################################################

###############################################################################
# Target runner for irace to tune AutoMoDe FSMs.
###############################################################################

# Path to the AutoMoDe executable
EXE=/home/ubuntu/mandarina-supp-mission/software/argos3-installation/automode/bin/automode_main

CONFIG_ID="$1"
INSTANCE_ID="$2"
SEED="$3"
INSTANCE="$4"

# Remaining parameters correspond to the FSM configuration
shift 4 || { echo "Error: Not enough parameters" >&2; exit 1; }
CONFIG_PARAMS="$@"

# --- LLM_MISSION_CLAMP : borne les destinations a [0, nstates-2] -------------
# La destination d'une transition est un indice parmi les AUTRES etats, donc
# elle vaut au plus nstates-2. La grammaire irace ne connait pas cette borne.
CONFIG_PARAMS=$(printf '%s' "$CONFIG_PARAMS" | awk '{
    n = 1
    for (i = 1; i <= NF; i++) if ($i == "--nstates") { n = $(i+1) + 0; break }
    max = n - 2; if (max < 0) max = 0
    for (i = 1; i < NF; i++)
        if ($i ~ /^--n[0-9]+x[0-9]+$/) {
            v = $(i+1) + 0
            if (v > max) v = max
            if (v < 0) v = 0
            $(i+1) = v
        }
    print
}')
# --- fin LLM_MISSION_CLAMP --------------------------------------------------


# Error handling function
error() {
    echo "$(TZ=UTC date): error: $@" >&2
    # irace expects a numeric value even in case of failure
    echo "1e10"
    exit 0
}

# Check if executable exists
if [ ! -x "${EXE}" ]; then
    error "${EXE}: not found or not executable (pwd: $(pwd))"
fi

# Build FSM configuration string
FSM_CONFIG="${CONFIG_PARAMS}"

# Execute AutoMoDe and capture output
OUTPUT=$(${EXE} -c "${INSTANCE}" --seed "${SEED}" --fsm-config ${FSM_CONFIG} 2>&1)

# Extract the score from the output
SCORE=$(echo "${OUTPUT}" | grep -o -E 'Score[[:space:]]+[-+0-9.e]+' | awk '{print $2}')

# Validate that the score is numeric
if ! [[ "$SCORE" =~ ^[-+0-9.eE]+$ ]]; then
    # Print error message to stderr for debugging
    echo "${OUTPUT}" >&2
    error "Output is not a number"
fi

# Print the score (value to be minimized by irace)
echo "$SCORE"
exit 0
